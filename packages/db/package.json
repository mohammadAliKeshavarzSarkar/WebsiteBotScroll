{
  "name": "@website-bot-scroll/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/client.ts",
    "./evidence": "./src/repositories/evidence.ts",
    "./definitions": "./src/repositories/definitions.ts",
    "./observation-records": "./src/repositories/observation-records.ts",
    "./artifacts": "./src/repositories/artifacts.ts",
    "./renderer-sessions": "./src/repositories/renderer-sessions.ts",
    "./diagnostics": "./src/repositories/diagnostics.ts",
    "./export-projections": "./src/repositories/export-projections.ts",
    "./sites": "./src/repositories/sites.ts",
    "./site-workspace": "./src/repositories/site-workspace.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate:test": "prisma migrate deploy --config prisma7.config.ts",
    "lint": "eslint src",
    "test": "vitest run --no-file-parallelism",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@website-bot-scroll/config": "workspace:*",
    "@website-bot-scroll/domain": "workspace:*",
    "@website-bot-scroll/observation-schema": "workspace:*",
    "argon2": "0.45.2",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.6",
    "prisma": "7.10.1"
  }
}
