generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  users     User[]
  sites     Site[]
  events    AuditEvent[]
  crawlRuns CrawlRun[]
  exportAuthorizations ExportAuthorization[]
  observationSubjects ObservationSubject[]
  observationExecutions ObservationExecution[]
  platformObservations PlatformObservation[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  email          String       @unique
  passwordHash   String       @map("password_hash")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions       Session[]
  events         AuditEvent[]

  @@index([organizationId])
  @@map("users")
}

model Session {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tokenDigest String   @unique @map("token_digest")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Site {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  name           String
  origin         String
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  verifications  DomainVerification[]
  events         AuditEvent[]
  crawlRuns      CrawlRun[]
  exportAuthorizations ExportAuthorization[]

  @@unique([organizationId, origin])
  @@index([organizationId, id])
  @@map("sites")
}

enum CrawlStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum CrawlTrigger {
  MANUAL
  SCHEDULED
  RETRY
}

model CrawlRun {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  siteId         String       @map("site_id") @db.Uuid
  trigger        CrawlTrigger
  idempotencyKey String       @map("idempotency_key")
  status         CrawlStatus  @default(PENDING)
  activeSiteKey  String?      @unique @map("active_site_key") @db.Uuid
  frontier       Json         @default("[]")
  processedUrls  Json         @default("[]") @map("processed_urls")
  attemptCount   Int          @default(0) @map("attempt_count")
  startedAt      DateTime?    @map("started_at")
  finishedAt     DateTime?    @map("finished_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  authorizationId String?     @map("authorization_id")
  scope          Json?
  limits         Json?
  producerVersion String?     @map("producer_version")
  normalizationPolicyVersion String? @map("normalization_policy_version")
  extractorVersion String?    @map("extractor_version")
  discoveredCount Int         @default(0) @map("discovered_count")
  attemptedCount Int          @default(0) @map("attempted_count")
  collectedCount Int          @default(0) @map("collected_count")
  failedCount Int             @default(0) @map("failed_count")
  unattemptedCount Int?       @map("unattempted_count")
  stopReason     String?      @map("stop_reason")
  frozenAt       DateTime?    @map("frozen_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  authorization  ExportAuthorization? @relation(fields: [authorizationId], references: [id], onDelete: Restrict)
  errors         CrawlError[]
  evidencePages  EvidencePage[]
  evidenceLimitations EvidenceLimitation[]
  evidenceErrors EvidenceError[]
  observationSubjects ObservationSubject[]
  observationExecutions ObservationExecution[]
  platformObservations PlatformObservation[]

  @@unique([siteId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([siteId, status])
  @@map("crawl_runs")
}

model ExportAuthorization {
  id             String       @id
  organizationId String       @map("organization_id") @db.Uuid
  siteId         String       @map("site_id") @db.Uuid
  description    String
  scope          Json
  createdAt      DateTime     @default(now()) @map("created_at")
  revokedAt      DateTime?    @map("revoked_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  crawlRuns      CrawlRun[]

  @@index([organizationId, siteId])
  @@map("export_authorizations")
}

model EvidencePage {
  id             String       @id
  crawlRunId     String       @map("crawl_run_id") @db.Uuid
  position       Int
  depth          Int
  discoveredUrl  String       @map("discovered_url")
  requestedUrl   String       @map("requested_url")
  normalizedUrl  String       @map("normalized_url")
  finalUrl       String       @map("final_url")
  canonicalUrls  Json         @map("canonical_urls")
  createdAt      DateTime     @default(now()) @map("created_at")
  crawlRun       CrawlRun     @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  transactions   EvidenceTransaction[]
  observations   EvidenceObservation[]
  limitations    EvidenceLimitation[]
  errors         EvidenceError[]

  @@unique([crawlRunId, position])
  @@index([crawlRunId, id])
  @@map("evidence_pages")
}

model EvidenceTransaction {
  id               String       @id
  pageId           String       @map("page_id")
  position         Int
  requestUrl       String       @map("request_url")
  responseUrl      String       @map("response_url")
  method           String
  statusCode       Int          @map("status_code")
  startedAt        DateTime     @map("started_at")
  finishedAt       DateTime     @map("finished_at")
  transferredBytes BigInt       @map("transferred_bytes")
  decodedBytes     BigInt       @map("decoded_bytes")
  redirectTo       String?      @map("redirect_to")
  createdAt        DateTime     @default(now()) @map("created_at")
  page             EvidencePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  headers          EvidenceHeader[]

  @@unique([pageId, position])
  @@index([pageId, id])
  @@map("evidence_transactions")
}

model EvidenceHeader {
  id            String              @id @default(uuid()) @db.Uuid
  transactionId String              @map("transaction_id")
  position      Int
  name          String
  transaction   EvidenceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  values        EvidenceHeaderValue[]

  @@unique([transactionId, position])
  @@map("evidence_headers")
}

model EvidenceHeaderValue {
  id       String         @id @default(uuid()) @db.Uuid
  headerId String         @map("header_id") @db.Uuid
  position Int
  value    String
  header   EvidenceHeader @relation(fields: [headerId], references: [id], onDelete: Cascade)

  @@unique([headerId, position])
  @@map("evidence_header_values")
}

model EvidenceObservation {
  id              String       @id
  pageId          String       @map("page_id")
  method          String
  status          String
  value           Json?
  reasons         Json
  provenance      Json
  fieldOverrides  Json?        @map("field_overrides")
  rawHash         String?      @map("raw_hash")
  normalizedHash  String?      @map("normalized_hash")
  createdAt       DateTime     @default(now()) @map("created_at")
  page            EvidencePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  errors          EvidenceError[]

  @@unique([pageId, method])
  @@index([pageId, id])
  @@map("evidence_observations")
}

model EvidenceLimitation {
  id         String        @id
  crawlRunId String        @map("crawl_run_id") @db.Uuid
  pageId     String?       @map("page_id")
  code       String
  message    String
  createdAt  DateTime      @default(now()) @map("created_at")
  crawlRun   CrawlRun      @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  page       EvidencePage? @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([crawlRunId, id])
  @@map("evidence_limitations")
}

model EvidenceError {
  id            String               @id
  crawlRunId    String               @map("crawl_run_id") @db.Uuid
  pageId        String?              @map("page_id")
  observationId String?              @map("observation_id")
  stage         String
  code          String
  message       String
  occurredAt    DateTime             @map("occurred_at")
  retryable     Boolean
  crawlRun      CrawlRun             @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  page          EvidencePage?        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  observation   EvidenceObservation? @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@index([crawlRunId, id])
  @@map("evidence_errors")
}

model CrawlError {
  id         String   @id @default(uuid()) @db.Uuid
  crawlRunId String   @map("crawl_run_id") @db.Uuid
  code       String
  message    String
  url        String?
  retryable  Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  crawlRun   CrawlRun @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)

  @@index([crawlRunId, createdAt])
  @@map("crawl_errors")
}

model ObservationDefinition {
  id             String   @id @default(uuid()) @db.Uuid
  key            String
  version        String
  schema         Json
  schemaSha256   String   @map("schema_sha256") @db.Char(64)
  scopes         Json
  statuses       Json
  sensitivity    String
  retentionClass String   @map("retention_class")
  status         String   @default("published")
  createdAt      DateTime @default(now()) @map("created_at")
  deprecatedAt   DateTime? @map("deprecated_at")
  capabilities   CollectorCapability[]
  observations   PlatformObservation[]

  @@unique([key, version])
  @@index([key, status])
  @@map("observation_definitions")
}

model CollectorDefinition {
  id                        String   @id @default(uuid()) @db.Uuid
  key                       String
  version                   String
  configurationSchema       Json     @map("configuration_schema")
  configurationSchemaSha256 String   @map("configuration_schema_sha256") @db.Char(64)
  executionMode             String   @map("execution_mode")
  status                    String   @default("published")
  createdAt                 DateTime @default(now()) @map("created_at")
  deprecatedAt              DateTime? @map("deprecated_at")
  capabilities              CollectorCapability[]
  executions                ObservationExecution[]

  @@unique([key, version])
  @@index([key, status])
  @@map("collector_definitions")
}

model CollectorCapability {
  collectorDefinitionId   String @map("collector_definition_id") @db.Uuid
  observationDefinitionId String @map("observation_definition_id") @db.Uuid
  position                Int
  collector               CollectorDefinition @relation(fields: [collectorDefinitionId], references: [id], onDelete: Cascade)
  observation             ObservationDefinition @relation(fields: [observationDefinitionId], references: [id], onDelete: Restrict)

  @@id([collectorDefinitionId, observationDefinitionId])
  @@unique([collectorDefinitionId, position])
  @@map("collector_capabilities")
}

model ObservationSubject {
  id             String   @id
  organizationId String   @map("organization_id") @db.Uuid
  crawlRunId     String   @map("crawl_run_id") @db.Uuid
  position       Int
  kind           String
  identity       Json
  createdAt      DateTime @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  crawlRun       CrawlRun @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  observations   PlatformObservation[]
  members        ObservationSubjectMember[] @relation("SubjectContainer")
  memberOf       ObservationSubjectMember[] @relation("SubjectMember")

  @@unique([crawlRunId, position])
  @@index([organizationId, crawlRunId, kind])
  @@map("observation_subjects")
}

model ObservationSubjectMember {
  subjectId       String @map("subject_id")
  memberSubjectId String @map("member_subject_id")
  position        Int
  subject         ObservationSubject @relation("SubjectContainer", fields: [subjectId], references: [id], onDelete: Cascade)
  memberSubject   ObservationSubject @relation("SubjectMember", fields: [memberSubjectId], references: [id], onDelete: Restrict)

  @@id([subjectId, memberSubjectId])
  @@unique([subjectId, position])
  @@map("observation_subject_members")
}

model ObservationExecution {
  id                    String   @id
  organizationId        String   @map("organization_id") @db.Uuid
  crawlRunId            String   @map("crawl_run_id") @db.Uuid
  collectorDefinitionId String   @map("collector_definition_id") @db.Uuid
  parentExecutionId     String?  @map("parent_execution_id")
  stableKey             String   @map("stable_key")
  attempt               Int
  trigger               String
  configuration         Json
  status                String   @default("running")
  startedAt             DateTime @map("started_at")
  finishedAt            DateTime? @map("finished_at")
  error                  Json?
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  crawlRun              CrawlRun @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  collector             CollectorDefinition @relation(fields: [collectorDefinitionId], references: [id], onDelete: Restrict)
  parent                ObservationExecution? @relation("ExecutionChildren", fields: [parentExecutionId], references: [id], onDelete: Restrict)
  children              ObservationExecution[] @relation("ExecutionChildren")
  observations          PlatformObservation[]

  @@unique([crawlRunId, stableKey, attempt])
  @@index([organizationId, crawlRunId, status])
  @@map("observation_executions")
}

model PlatformObservation {
  id                      String   @id
  organizationId          String   @map("organization_id") @db.Uuid
  crawlRunId              String   @map("crawl_run_id") @db.Uuid
  subjectId               String   @map("subject_id")
  executionId             String   @map("execution_id")
  observationDefinitionId String   @map("observation_definition_id") @db.Uuid
  sequence                Int
  status                  String
  payload                 Json?
  reasons                 Json
  provenance              Json
  collectedAt             DateTime @map("collected_at")
  createdAt               DateTime @default(now()) @map("created_at")
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  crawlRun                CrawlRun @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  subject                 ObservationSubject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  execution               ObservationExecution @relation(fields: [executionId], references: [id], onDelete: Restrict)
  definition              ObservationDefinition @relation(fields: [observationDefinitionId], references: [id], onDelete: Restrict)

  @@unique([executionId, sequence])
  @@index([organizationId, crawlRunId, subjectId])
  @@map("platform_observations")
}

model DomainVerification {
  id        String    @id @default(uuid()) @db.Uuid
  siteId    String    @map("site_id") @db.Uuid
  method    String
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt DateTime  @default(now()) @map("created_at")
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, expiresAt])
  @@map("domain_verifications")
}

model AuditEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  siteId         String?       @map("site_id") @db.Uuid
  action         String
  targetId       String?       @map("target_id")
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  site           Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([siteId, createdAt])
  @@map("audit_events")
}
